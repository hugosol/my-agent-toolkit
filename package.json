{
  "name": "my-agent-toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --parallel=12",
    "test:serial": "bun test",
    "test:dock": "bun test tests/harness-dock --parallel=4",
    "test:dock:serial": "bun test tests/harness-dock",
    "test:framework": "bun test tests/framework",
    "test:codebase-tools": "bun test tests/codebase-tools",
    "smoke:http-transport": "bun scripts/http-transport-smoke.ts",
    "smoke:model-cost-data": "bun scripts/model-cost-data-smoke.ts",
    "baseline:efficiency": "bun --preload ./scripts/support/efficiency-baseline-fs-instrument.ts ./scripts/efficiency-baseline.ts",
    "compare:efficiency": "bun scripts/efficiency-comparison.ts",
    "smoke:model-cost-detail-layout": "bun scripts/model-cost-detail-layout-smoke.ts",
    "smoke:model-cost-detail-layout-terminal": "bun scripts/model-cost-detail-layout-terminal-smoke.ts",
    "accept:model-cost-tui": "bun scripts/pi-tui-acceptance.ts",
    "check:integrations": "bun scripts/check-adapter-integrations.ts",
    "generate:integrations": "bun scripts/generate-adapter-integrations.ts",
    "check:authoring": "bun scripts/check-authoring.ts",
    "verify:omp-candidate": "bun scripts/verify-omp-candidate.ts",
    "verify:provider-account": "bun scripts/pi-provider-account-read.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit && bun run check:authoring"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@5.9.3"
  },
  "dependencies": {
    "pi-subagents": "0.78.0",
    "yaml": "^2.9.1"
  }
}
