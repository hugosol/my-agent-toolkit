# The host patch artifacts are frozen byte-for-byte by their sibling record.json
# (patch sha256 plus pre/post hashes of the patched files). A CRLF checkout changes
# those bytes, so keep the diffs exactly as recorded on every platform.
.gitattributes text eol=lf
host-patches/**/*.diff text eol=lf
# Historical native-session captures must retain their original LF bytes.
tests/framework/fixtures/pi-history/*.jsonl text eol=lf
