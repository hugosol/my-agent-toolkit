index 0000000..7d07805
--- /dev/null
+++ b/src/extensibility/extensions/viewed-session.ts
@@ -0,0 +1,274 @@
+/**
+ * The viewed session: the public read-only outlet for "which session is this host displaying,
+ * and what are its facts right now".
+ *
+ * A session's own extension context already answers what *its* session is doing. It cannot
+ * answer what the operator is *looking at*, which differs as soon as the interactive view is
+ * focused on a subagent. This module owns that fact once:
+ *
+ * - {@link ViewedSessionFacts} is the public snapshot — the displayed session's identity, its
+ *   direct parent, its latest display name, its provider/model, its actual effective effort and
+ *   its context usage. A fact the host cannot obtain is named in `unavailable` instead of being
+ *   guessed, and no private controller or rendered text is read to fill a gap.
+ * - {@link ViewedSessionSource} is the read-and-notify pair an extension consumes through
+ *   `ctx.getViewedSession()` / `ctx.subscribeViewedSessionChanged()`.
+ * - {@link ViewedSessionBroadcaster} is the change bus: it watches the live session behind the
+ *   current view and fans a fresh snapshot out when the target or its facts change.
+ * - {@link ViewedSessionOutlet} is the process-wide registration point for the one mode that
+ *   owns a view. Nothing registered means there is no separate view, so every runner reports its
+ *   own session as the displayed one.
+ *
+ * Read-only by construction: nothing here reaches a session's execution, ownership or write
+ * authority, so viewing a session can never change what that session is doing.
+ */
+import { logger } from "@oh-my-pi/pi-utils";
+
+/** A fact of the displayed session that a host may be unable to obtain. */
+export type ViewedSessionFactName = "sessionId" | "name" | "provider" | "model" | "effort" | "context";
+
+/** Context usage of the displayed session: estimated tokens in use and the window they fill. */
+export interface ViewedSessionContextUsage {
+	/** Estimated context tokens in use. */
+	tokens: number;
+	/** Context window of the model the displayed session runs. */
+	contextWindow: number;
+}
+
+/**
+ * One snapshot of the session the host currently displays.
+ *
+ * Every optional field that is absent is also named in {@link ViewSessionFacts.unavailable}:
+ * an absent value always means "this host could not obtain it here", never "zero", "default" or
+ * "same as the main session".
+ */
+export interface ViewedSessionFacts {
+	/** Identity of the displayed agent: registry id, main/sub kind and its direct parent. */
+	agent: {
+		id: string;
+		kind: "main" | "sub";
+		parentId?: string;
+	};
+	/** Session id the harness reports for the displayed session. */
+	sessionId?: string;
+	/** Latest display name of the displayed session. */
+	name?: string;
+	/** Provider of the displayed session's current model. */
+	provider?: string;
+	/** Id of the displayed session's current model. */
+	model?: string;
+	/** The displayed session's actual effective effort (its thinking level), not the configured intent. */
+	effort?: string;
+	/** Context usage of the displayed session. */
+	context?: ViewedSessionContextUsage;
+	/** Every fact above this host could not obtain; each name here has an absent value above. */
+	unavailable: readonly ViewedSessionFactName[];
+}
+
+/** Raw facts a host mode has about the session it displays, before unavailable facts are named. */
+export interface ViewedSessionTarget {
+	agent: {
+		id: string;
+		kind: "main" | "sub";
+		parentId?: string;
+	};
+	sessionId?: string;
+	name?: string;
+	provider?: string;
+	model?: string;
+	effort?: string;
+	context?: ViewedSessionContextUsage;
+}
+
+/**
+ * Project raw host facts into the public snapshot, naming every fact that is absent. This is
+ * the single place the "absent means unavailable" rule is applied, so a new host mode cannot
+ * publish a snapshot that hides the difference.
+ */
+export function viewedSessionFacts(target: ViewedSessionTarget): ViewedSessionFacts {
+	const unavailable: ViewedSessionFactName[] = [];
+	const fact = <T>(name: ViewedSessionFactName, value: T | undefined): T | undefined => {
+		if (value === undefined) unavailable.push(name);
+		return value;
+	};
+	return {
+		agent: {
+			id: target.agent.id,
+			kind: target.agent.kind,
+			...(target.agent.parentId === undefined ? {} : { parentId: target.agent.parentId }),
+		},
+		sessionId: fact("sessionId", target.sessionId),
+		name: fact("name", target.name),
+		provider: fact("provider", target.provider),
+		model: fact("model", target.model),
+		effort: fact("effort", target.effort),
+		context: fact("context", target.context),
+		unavailable,
+	};
+}
+
+/** Live session facts and change events, as much of a session as the outlet reads. */
+export interface ViewedSessionSessionLike {
+	/** Latest display name of that session. */
+	readonly sessionName?: string | undefined;
+	/** Session id the harness reports. */
+	readonly sessionId?: string | undefined;
+	/** Current model of that session. */
+	readonly model?: { readonly provider: string; readonly id: string } | undefined;
+	/** Actual effective effort of that session. */
+	readonly thinkingLevel?: string | undefined;
+	/** Context usage of that session, when it can be measured. */
+	getContextUsage(): ViewedSessionContextUsage | undefined;
+	/** Subscribe to that session's own events (its `model_changed`/`thinking_level_changed`/message events). */
+	subscribe(listener: (event: { readonly type: string }) => void): () => void;
+}
+
+/** The session a host mode displays right now, plus the live session behind it. */
+export interface ViewedSessionView {
+	readonly target: ViewedSessionTarget;
+	/** Live session behind the target; its events are the fact changes of that target. */
+	readonly session?: ViewedSessionSessionLike;
+}
+
+/** Read-and-notify pair behind `ctx.getViewedSession()` and `ctx.subscribeViewedSessionChanged()`. */
+export interface ViewedSessionSource {
+	/** Current snapshot; always re-read, never a cached or stale copy. */
+	read(): ViewedSessionFacts;
+	/** Delivers a fresh snapshot whenever the displayed target or its facts change; returns the unsubscribe. */
+	subscribe(listener: (facts: ViewedSessionFacts) => void): () => void;
+}
+
+/**
+ * Session events that can change the snapshot's model, effort or context. Anything else —
+ * token deltas, tool progress, queue updates — leaves every published fact untouched.
+ */
+const FACT_CHANGE_EVENTS: Record<string, true> = {
+	model_changed: true,
+	retry_fallback_applied: true,
+	thinking_level_changed: true,
+	message_start: true,
+	message_end: true,
+	agent_end: true,
+	auto_compaction_end: true,
+};
+
+/**
+ * Change bus over one {@link ViewedSessionView}: reads the view on demand, follows the live
+ * session behind it (re-pointing when the view moves), and delivers a fresh snapshot to every
+ * subscriber on {@link notify}.
+ *
+ * `notify` is the host's own signal, so the semantics stay explicit: a target switch or an
+ * invalidation is a host transition and notifies directly, while a same-target fact change is
+ * a session event and notifies through the watch.
+ */
+export class ViewedSessionBroadcaster implements ViewedSessionSource {
+	#listeners = new Set<(facts: ViewedSessionFacts) => void>();
+	#watched: ViewedSessionSessionLike | undefined;
+	#unwatch: (() => void) | undefined;
+
+	constructor(private readonly view: () => ViewedSessionView) {}
+
+	read(): ViewedSessionFacts {
+		return viewedSessionFacts(this.view().target);
+	}
+
+	subscribe(listener: (facts: ViewedSessionFacts) => void): () => void {
+		this.#listeners.add(listener);
+		this.#follow();
+		let subscribed = true;
+		return () => {
+			if (!subscribed) return;
+			subscribed = false;
+			this.#listeners.delete(listener);
+			if (this.#listeners.size === 0) this.#unwatchSession();
+		};
+	}
+
+	/** Re-read the view and deliver the current snapshot to every subscriber. */
+	notify(): void {
+		if (this.#listeners.size === 0) {
+			this.#follow();
+			return;
+		}
+		this.#follow();
+		const facts = this.read();
+		for (const listener of [...this.#listeners]) {
+			try {
+				listener(facts);
+			} catch (error) {
+				// A consumer's throw must never take down the agent loop or hide the other subscribers.
+				logger.warn("Viewed session change listener threw", { error: String(error) });
+			}
+		}
+	}
+
+	/** Drop every subscriber and the session watch. */
+	dispose(): void {
+		this.#listeners.clear();
+		this.#unwatchSession();
+	}
+
+	/** Point the fact watch at the session behind the current view, following view moves. */
+	#follow(): void {
+		const session = this.view().session;
+		if (session === this.#watched) return;
+		this.#unwatchSession();
+		this.#watched = session;
+		this.#unwatch = session?.subscribe(event => {
+			if (FACT_CHANGE_EVENTS[event.type] === true) this.notify();
+		});
+	}
+
+	#unwatchSession(): void {
+		this.#unwatch?.();
+		this.#unwatch = undefined;
+		this.#watched = undefined;
+	}
+}
+
+/**
+ * A view over one live session: the session the host displays when it has no separate view.
+ * Identity comes from the agent the runner serves; name, model, effort and context come from
+ * the session itself.
+ */
+export function createSessionViewedSessionSource(options: {
+	readonly agent: { readonly id: string; readonly kind: "main" | "sub"; readonly parentId?: string };
+	readonly session: ViewedSessionSessionLike;
+}): ViewedSessionSource {
+	const target = (): ViewedSessionTarget => ({
+		agent: options.agent,
+		sessionId: options.session.sessionId,
+		name: options.session.sessionName,
+		provider: options.session.model?.provider,
+		model: options.session.model?.id,
+		effort: options.session.thinkingLevel,
+		context: options.session.getContextUsage(),
+	});
+	return new ViewedSessionBroadcaster(() => ({ target: target(), session: options.session }));
+}
+
+/**
+ * Process-wide registration point for the one host mode that owns a view (the interactive TUI).
+ * A mode registers its source here so that every runner in the process — the main session's and
+ * each subagent's — observes the same view. Nothing registered means no separate view exists and
+ * each runner reports its own session.
+ */
+export class ViewedSessionOutlet {
+	static #global: ViewedSessionOutlet | undefined;
+
+	/** The process-wide outlet. */
+	static global(): ViewedSessionOutlet {
+		return (ViewedSessionOutlet.#global ??= new ViewedSessionOutlet());
+	}
+
+	#source: ViewedSessionSource | undefined;
+
+	/** Register the mode-owned view source, or clear it with `undefined` on teardown. */
+	setSource(source: ViewedSessionSource | undefined): void {
+		this.#source = source;
+	}
+
+	/** The registered view source, if a mode owns a view in this process. */
+	get source(): ViewedSessionSource | undefined {
+		return this.#source;
+	}
+}
